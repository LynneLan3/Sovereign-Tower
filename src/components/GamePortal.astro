---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { game } from '../config/game';
import { resolveGameAsset } from '../lib/assets';
import { categoryIdOf, categoryOf, getGuides, guideHref, sortGuides } from '../lib/guides';
import CategorySummaryCard from './CategorySummaryCard.astro';
import EvidenceSection from './EvidenceSection.astro';
import GuideGrid from './GuideGrid.astro';
import StartHereCard from './StartHereCard.astro';

const guides = await getGuides();
const heroImage = resolveGameAsset(game.heroImage);
const heroPosition = game.heroPosition ?? 'center';
const categories = [...game.categories].sort((a, b) => a.order - b.order);

const featured = guides.filter((entry) => entry.data.featured).sort(sortGuides).slice(0, 4);

type StartHereView = {
	title: string;
	description: string;
	href: string;
	image?: ImageMetadata;
	label?: string;
	badge?: string;
};

const configuredStartHere = game.portal?.startHere;
const startHere: StartHereView[] = configuredStartHere?.length
	? configuredStartHere.slice(0, 4).map((item) => ({
			title: item.title,
			description: item.description,
			href: item.href,
			image: resolveGameAsset(item.image),
			label: item.label,
			badge: item.badge,
		}))
	: featured.map((entry) => {
			const category = categoryOf(entry);
			return {
				title: entry.data.title,
				description: entry.data.description ?? '',
				href: guideHref(entry),
				image: entry.data.cover,
				label: category?.label,
				badge: entry.data.status,
			};
		});

const startHereHrefs = new Set(startHere.map((item) => item.href));

const sections = categories
	.map((category) => ({
		category,
		entries: guides.filter((entry) => categoryIdOf(entry) === category.id).sort(sortGuides),
	}))
	.filter((section) => section.entries.length > 0);

const moreGuides = guides
	.filter((entry) => !startHereHrefs.has(guideHref(entry)))
	.sort(sortGuides)
	.slice(0, 6);

const popularQuestions = game.portal?.popularQuestions ?? [];
const showRecentlyUpdated = game.portal?.showRecentlyUpdated !== false;
const maxRecent = game.portal?.maxRecent ?? 3;
const showAbout = game.portal?.showAbout !== false;
const heroBadge = game.portal?.heroBadge;

const evidenceConfig = game.portal?.evidence;
const evidenceItems =
	evidenceConfig?.items
		.map((item) => {
			const image = resolveGameAsset(item.image);
			if (!image) return null;
			return {
				image,
				alt: item.alt,
				caption: item.caption,
				href: item.href,
			};
		})
		.filter((item): item is NonNullable<typeof item> => item !== null) ?? [];
const showEvidence = evidenceItems.length > 0;

type RecentView = {
	title: string;
	href: string;
	date: Date;
	changeSummary?: string;
	tag?: string;
};

const curatedRecent = game.portal?.recentUpdates;
const recentlyUpdated: RecentView[] = !showRecentlyUpdated
	? []
	: curatedRecent?.length
		? curatedRecent.slice(0, maxRecent).map((item) => ({
				title: item.title,
				href: item.href,
				date: new Date(item.date),
				changeSummary: item.changeSummary,
				tag: item.tag,
			}))
		: guides
				.filter((entry) => entry.data.lastUpdated instanceof Date)
				.sort((a, b) => {
					const dateA = a.data.lastUpdated as Date;
					const dateB = b.data.lastUpdated as Date;
					return dateB.getTime() - dateA.getTime();
				})
				.slice(0, maxRecent)
				.map((entry) => {
					const category = categoryOf(entry);
					return {
						title: entry.data.title,
						href: guideHref(entry),
						date: entry.data.lastUpdated as Date,
						changeSummary: entry.data.changeSummary,
						tag: category?.label,
					};
				});

const primaryCta =
	game.portal?.primaryCta ??
	(startHere[0] ? { label: startHere[0].title, href: startHere[0].href } : undefined);
const secondaryCta = game.portal?.secondaryCta;
---

<div class="gw-portal">
	<section class:list={['gw-hero', heroImage && 'gw-hero--media']}>
		{
			heroImage && (
				<div class="gw-hero__visual">
					<Image
						src={heroImage}
						alt={game.heroAlt ?? game.name}
						width={1920}
						height={620}
						widths={[800, 1280, 1920]}
						sizes="(min-width: 50em) 48rem, 100vw"
						loading="eager"
						fetchpriority="high"
						style={{ objectPosition: heroPosition }}
					/>
				</div>
			)
		}
		<div class="gw-hero__copy">
			{
				heroBadge ? (
					<p class="gw-hero__badge">{heroBadge}</p>
				) : (
					<p class="gw-hero__kicker">Guide & Wiki</p>
				)
			}
			<p class="gw-hero__game">{game.name}</p>
			<h1 id="_top">{game.hubTitle ?? `${game.name} Guide & Wiki`}</h1>
			<p class="gw-hero__tagline">{game.tagline}</p>
			<ul class="gw-hero__strip" aria-label="Game facts">
				<li>
					<span class="gw-hero__strip-label">Release</span>
					<span>{game.releaseDate}</span>
				</li>
				<li>
					<span class="gw-hero__strip-label">Platforms</span>
					<span>{game.platforms.join(' · ')}</span>
				</li>
				<li>
					<span class="gw-hero__strip-label">Developer</span>
					<span>{game.developer}</span>
				</li>
			</ul>
			{
				(primaryCta || secondaryCta) && (
					<div class="gw-hero__actions">
						{primaryCta && (
							<a class="gw-btn gw-btn--primary" href={primaryCta.href}>
								{primaryCta.label}
							</a>
						)}
						{secondaryCta && (
							<a class="gw-btn gw-btn--ghost" href={secondaryCta.href}>
								{secondaryCta.label}
							</a>
						)}
					</div>
				)
			}
		</div>
	</section>

	{
		popularQuestions.length > 0 && (
			<section class="gw-section gw-section--tight">
				<h2 class="gw-visually-hidden">Popular Questions</h2>
				<ul class="gw-questions">
					{popularQuestions.map((question) => (
						<li>
							<a class="gw-chip" href={question.href}>
								{question.label}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		startHere.length > 0 && (
			<section class="gw-section gw-section--surface" aria-labelledby="gw-start-here-heading">
				<header class="gw-section__header">
					<p class="gw-section__eyebrow">Player path</p>
					<h2 id="gw-start-here-heading">Start Here</h2>
					<p class="gw-section__lede">Four high-priority ways into the game — pick the task you need first.</p>
				</header>
				<div class="gw-start-grid">
					{startHere.map((item) => (
						<StartHereCard
							title={item.title}
							description={item.description}
							href={item.href}
							image={item.image}
							label={item.label}
							badge={item.badge}
						/>
					))}
				</div>
			</section>
		)
	}

	{
		sections.length > 0 && (
			<section class="gw-section" id="browse-guides" aria-labelledby="gw-browse-heading">
				<header class="gw-section__header">
					<p class="gw-section__eyebrow">Explore</p>
					<h2 id="gw-browse-heading">Browse Guides</h2>
					<p class="gw-section__lede">Jump by topic. Category landings stay navigational; guides stay indexable.</p>
				</header>
				<div class="gw-browse">
					{sections.map(({ category, entries }) => (
						<CategorySummaryCard {category} {entries} />
					))}
				</div>
			</section>
		)
	}

	{
		showEvidence && (
			<EvidenceSection
				title={evidenceConfig?.title ?? 'See the Game in Action'}
				description={evidenceConfig?.description}
				items={evidenceItems}
			/>
		)
	}

	{
		moreGuides.length > 0 && (
			<section class="gw-section gw-section--surface" aria-labelledby="gw-more-guides-heading">
				<header class="gw-section__header">
					<p class="gw-section__eyebrow">Keep reading</p>
					<h2 id="gw-more-guides-heading">More Guides</h2>
					<p class="gw-section__lede">Additional pages beyond the Start Here path.</p>
				</header>
				<GuideGrid entries={moreGuides} />
			</section>
		)
	}

	{
		recentlyUpdated.length > 0 && (
			<section class="gw-section" aria-labelledby="gw-recent-heading">
				<header class="gw-section__header">
					<p class="gw-section__eyebrow">Editorial</p>
					<h2 id="gw-recent-heading">Recently Updated</h2>
					<p class="gw-section__lede">What changed — not only which page moved.</p>
				</header>
				<ul class="gw-recent">
					{recentlyUpdated.map((item) => (
						<li>
							<a href={item.href}>
								<span class="gw-recent__main">
									<span class="gw-recent__title">{item.title}</span>
									{item.changeSummary && <span class="gw-recent__change">{item.changeSummary}</span>}
								</span>
								<span class="gw-recent__meta">
									{item.tag && <span class="gw-recent__tag">{item.tag}</span>}
									<time datetime={item.date.toISOString()}>{item.date.toISOString().slice(0, 10)}</time>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		showAbout && (
			<section class="gw-section gw-about">
				<h2>About {game.name}</h2>
				<p class="gw-about__desc">{game.description}</p>
				<dl class="gw-facts">
					<div>
						<dt>Release</dt>
						<dd>{game.releaseDate}</dd>
					</div>
					<div>
						<dt>Developer</dt>
						<dd>{game.developer}</dd>
					</div>
					<div>
						<dt>Publisher</dt>
						<dd>{game.publisher}</dd>
					</div>
					<div>
						<dt>Platforms</dt>
						<dd>{game.platforms.join(' · ')}</dd>
					</div>
				</dl>
			</section>
		)
	}
</div>
